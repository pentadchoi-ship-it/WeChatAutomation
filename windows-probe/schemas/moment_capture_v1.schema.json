{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "moment_capture_v1.schema.json",
  "title": "WeChat Moment Capture V1",
  "type": "object",
  "required": ["schemaVersion", "source", "capturedAt", "status", "materials"],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "source": {
      "type": "string",
      "const": "wechat_windows_moments"
    },
    "capturedAt": {
      "type": "string"
    },
    "captureSessionId": {
      "type": "string"
    },
    "directory": {
      "type": "string"
    },
    "postId": {
      "type": "string"
    },
    "status": {
      "enum": ["captured", "partial", "skipped", "unavailable", "permission_denied", "load_failed", "draft"]
    },
    "postType": {
      "enum": ["unknown", "pure_text", "image_set", "video", "external_url", "mixed"]
    },
    "author": {
      "type": "object",
      "properties": {
        "displayName": { "type": "string" },
        "profileId": { "type": "string" }
      },
      "additionalProperties": true
    },
    "postedAtText": {
      "type": "string"
    },
    "text": {
      "type": ["object", "null"],
      "properties": {
        "textFile": { "type": "string" },
        "length": { "type": "integer" },
        "sha256": { "type": "string" },
        "captureMethod": { "type": "string" },
        "isFoldedAtCapture": { "type": "boolean" }
      },
      "additionalProperties": false
    },
    "location": {
      "type": ["object", "null"],
      "properties": {
        "label": { "type": "string" },
        "urlFile": { "type": "string" },
        "urlLength": { "type": "integer" },
        "urlSha256": { "type": "string" },
        "captureMethod": { "type": "string" }
      },
      "additionalProperties": true
    },
    "interactions": {
      "type": "object",
      "properties": {
        "status": {
          "enum": ["not_attempted", "captured", "partial", "unavailable"]
        },
        "likes": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "displayName": { "type": "string" },
              "profileId": { "type": "string" }
            },
            "additionalProperties": true
          }
        },
        "comments": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "authorName": { "type": "string" },
              "replyToName": { "type": "string" },
              "textFile": { "type": "string" },
              "length": { "type": "integer" },
              "sha256": { "type": "string" }
            },
            "additionalProperties": true
          }
        },
        "likeCountText": { "type": "string" },
        "commentCountText": { "type": "string" }
      },
      "additionalProperties": true
    },
    "materials": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "required": ["kind", "path", "length", "sha256"],
            "properties": {
              "kind": { "enum": ["image", "video", "file", "screenshot", "avatar", "cover"] },
              "role": { "type": "string" },
              "path": { "type": "string" },
              "length": { "type": "integer" },
              "sha256": { "type": "string" },
              "captureMethod": { "type": "string" }
            },
            "additionalProperties": true
          },
          {
            "type": "object",
            "required": ["kind", "urlFile", "urlLength", "urlSha256"],
            "properties": {
              "kind": { "const": "external_url" },
              "providerHint": {
                "enum": ["unknown", "video_account", "article", "link", "mini_program", "music", "product", "location"]
              },
              "title": { "type": "string" },
              "urlFile": { "type": "string" },
              "urlLength": { "type": "integer" },
              "urlSha256": { "type": "string" },
              "captureMethod": { "type": "string" }
            },
            "additionalProperties": true
          }
        ]
      }
    },
    "uiEvidence": {
      "type": "object",
      "properties": {
        "screenshots": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "path": { "type": "string" },
              "length": { "type": "integer" },
              "sha256": { "type": "string" },
              "purpose": { "type": "string" }
            },
            "additionalProperties": true
          }
        },
        "probeRun": { "type": "string" }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
